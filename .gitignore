*.dSYM/
*.o
a.out

# Generated server executables; keep directories required by the Makefiles.
/client-server/bin/*
!/client-server/bin/.gitkeep
/naming-server/bin/*
!/naming-server/bin/.gitkeep
/storage-server/bin/*
!/storage-server/bin/.gitkeep

# Local credentials and environment settings.
.env
.env.*
!.env.example
